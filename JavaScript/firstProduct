const product = {
    name : "ball pen",
    rating: 4,
    price : 270,
    offer: 5 
};

console.log(product);

const discountAmount = product.price * (product.offer / 100);
const discountedPrice = product.price - discountAmount;

console.log(`Discount: ${discountAmount}`);
console.log(`Price after discount: ${discountedPrice}`);
